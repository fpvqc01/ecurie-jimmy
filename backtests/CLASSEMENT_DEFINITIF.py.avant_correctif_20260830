            cle = (garde, deb, fin)
            if cle not in cache:
                cache[cle] = B.charger(garde)
            cagr, dd, tj, tjr, tjo = series(cache[cle], be, deb, fin)
            a = SF.simuler(tj, tjr, tjo, piste_min=piste, r13=False, turbo=turbo)
            b = SF.simuler(tj, tjr, tjo, piste_min=piste, r13=True, turbo=turbo)
            creux = "  n/d " if turbo else ("%6.1f%%" % dd)   # turbo : creux non mesurable ainsi
            print("%-24s %+5.1f%% %7s | %4.1f%% [%4.1f-%4.1f] %5.0f %5.0f %5.0f | %4.1f%% [%4.1f-%4.1f] %5.0f %5.0f %5.0f"
                  % (nom, cagr, creux,
                     a["reussite"], a["ic95"][0], a["ic95"][1],
