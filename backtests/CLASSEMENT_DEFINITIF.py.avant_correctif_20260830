            ("3 ans   ", "2023-08-21", "2026-08-20", 365))


# ------------------------------------------------------------------ #
# Instrumentation : P&L realise + jours d'OUVERTURE (correctif C3)
# ------------------------------------------------------------------ #
def instrumenter(s):
    s.pnl_r = {}
    s.ouvertures = {}
    s._cum0 = 0.0
    ouvrir0, clore0 = s.ouvrir, s._clore
    tot = lambda: sum(s.pnl.values())          # noqa: E731

    def ouvrir(t, *a, **k):
        avant = tot()
        r = ouvrir0(t, *a, **k)
        if r and s.pos is not None:
            s._cum0 = avant
            s.ouvertures[t.date()] = 1         # C3 : jour de trading FTMO
        return r

    def _clore(t, prix):
        clore0(t, prix)
        s.pnl_r[t] = s.pnl_r.get(t, 0.0) + (tot() - s._cum0)

    s.ouvrir, s._clore = ouvrir, _clore
    return s


def series(ns0, garde_be, debut, fin, alloc=None):
    """Retourne (cagr, dd, marque_au_marche, realise, ouvertures)."""
    ns, f_or, fab = ns0["ns"], ns0["f_or"], ns0["fab_l431"]
    boite = []

    def f():
        sl = fab()()
        a = ALLOC if alloc is None else alloc
        for s in sl:
            if s.nom in a:
                s.risque = a[s.nom]
        if garde_be:
            for s in sl:
                if s.nom in PYR:
                    B.breakeven(s, garde_be)
        for s in sl:
            instrumenter(s)
        boite[:] = sl
        return sl

    ns["DEBUT"], ns["FIN"] = debut, fin
    ns["sleeves_l4"] = f
    r = ns["sim_h4"](interdit=f_or)

    tj = r[6].sort_index()
    realise, ouverts = {}, {}
    for s in boite:
        for tt, vv in s.pnl_r.items():
            j = tt.date()
            realise[j] = realise.get(j, 0.0) + vv
        for j in s.ouvertures:
            ouverts[j] = 1

    tjr = pd.Series([realise.get(j.date(), 0.0) for j in tj.index], index=tj.index)
    tjo = pd.Series([ouverts.get(j.date(), 0) for j in tj.index], index=tj.index)
    return r[0], r[2], tj, tjr, tjo


# ------------------------------------------------------------------ #
def rediriger_vers_donnees():
    """Pointe le moteur sur le jeu de reference audite au lieu de backtests/."""
    if not os.path.isdir(DONNEES):
        sys.exit("dossier de reference introuvable : " + DONNEES)
    manifeste = os.path.join(DONNEES, "MANIFESTE.txt")
    if not os.path.isfile(manifeste):
        sys.exit("MANIFESTE.txt absent - lancer FIGER_donnees.py d'abord")
    txt = io.open(manifeste, encoding="utf-8").read()
    if "JEU DE DONNEES SAIN" not in txt:
        sys.exit("le manifeste signale des anomalies - refus de tourner")
    emp = [l for l in txt.splitlines() if l.startswith("EMPREINTE GLOBALE")]
    return emp[0] if emp else "EMPREINTE inconnue"


# (nom, gardien, breakeven, turbo)
# turbo = (multiplicateur, seuil d equite de phase) ou None.
# ATTENTION : les lignes turbo sont une BORNE OPTIMISTE - multiplier la
# serie de rendements apres coup ne tient pas compte du fait que des
# positions plus grosses touchent d autres stops. Voir SIMULATEUR_FTMO.
CONFIGS = (
    ("L6   (g2,50 sans BE)", 0.0250, None, None),
    ("L6+  turbo-coussin",   0.0250, None, (1.33, 0.04)),
    ("L6++ (g2,50 + BE5%)",  0.0250, 0.05, None),
    ("L6++ 5% + turbo",      0.0250, 0.05, (1.33, 0.04)),
    ("L8   (g1,75 + BE5%)",  0.0175, 0.05, None),
    ("L9   (g2,50 + BE5%)",  0.0250, 0.05, None),
    ("g2,00 + BE5%",         0.0200, 0.05, None),
    ("g1,75 sans BE",        0.0175, None, None),
    ("g1,50 + BE5%",         0.0150, 0.05, None),
)


