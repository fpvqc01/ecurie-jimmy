# (libelle, debut, fin, piste_min)
# piste_min = jours garantis apres chaque depart. Sur une fenetre courte
# il faut la reduire, sinon il ne reste presque aucun depart ; les
# challenges non termines sont alors comptes comme des ECHECS
# (conservateur), jamais jetes.
FENETRES = (("10 ans  ", "2015-08-21", "2026-12-31", 730),
